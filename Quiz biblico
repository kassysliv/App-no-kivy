class StartScreen(Screen): # ele inicializa a tela com m layout vertical, e com um espaço
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=20, spacing=20)

        title = Label(
            text="[b]Bem-vindo ao Quiz Bíblico![/color][/b]", #adcione um código de título e o tamanho das letras, e centralizei no meio
            font_size=32,
            markup=True,
            halign="center",
            color= (1, 1, 1, 1)
        )

        subtitle = Label(
            text="[i]Teste seus conhecimentos sobre a Bíblia![/i]",#subtitulo da interface e em itálico
            font_size=18,
            markup=True,
            color=(1, 1, 1, 1)
        )

        self.difficulty_spinner = Spinner( #nessa parte adicione um botao para selecionar a dificuldade e tem a opção de fácil medio e difícil
            text='Selecione a dificuldade',
            values=('Fácil', 'Médio', 'Difícil'),
            size_hint=(1, 0.3),
            background_color=(0, 0, 1, 1)
        )

        start_button = Button( # botao para inciar o quiz, e tambem ele define a cor do texto e a do fundo
            text="Começar",
            font_size=24,
            size_hint=(1, 0.3),
            background_color=(0, 0, 1, 1)

        )
        start_button.bind(on_press=self.start_quiz)



        layout.add_widget(title) #para adicinar o layout na tela
        layout.add_widget(subtitle)
        layout.add_widget(self.difficulty_spinner)
        layout.add_widget(start_button)
        self.add_widget(layout)

    def start_quiz(self, instance):# adicionei  uma funcao, quando o botão "Começar" é pressionado. Se uma dificuldade for desejada, muda para a tela do quiz e define a dificuldade
        selected_difficulty = self.difficulty_spinner.text
        if selected_difficulty != 'Selecione a dificuldade':
            self.manager.current = 'quiz'
            self.manager.get_screen('quiz').set_difficulty(selected_difficulty)

