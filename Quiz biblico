        self.layout.add_widget(self.progress_bar)
        self.layout.add_widget(self.question_label)
        for button in self.option_buttons:
            self.layout.add_widget(button)
        self.layout.add_widget(hint_button_layout)
        self.layout.add_widget(self.hint_label)
        self.add_widget(self.layout)

    # define a dificuldade e embaralhar as perguntas
    def set_difficulty(self, difficulty):
        if difficulty == 'Fácil':
            self.questions = self.select_questions(self.easy_questions)
        elif difficulty == 'Médio':
            self.questions = self.select_questions(self.medium_questions)
        elif difficulty == 'Difícil':
            self.questions = self.select_questions(self.hard_questions)
        random.shuffle(self.questions)  # Embaralha as perguntas
        self.progress_bar.max = len(self.questions)
        self.update_question()

    # selecionar 10 perguntas aleatórias
    def select_questions(self, question_pool):
        return random.sample(question_pool, min(10, len(question_pool)))

    # atualizar as perguntas atuais
    def update_question(self):
        if self.question_index < len(self.questions):
            question = self.questions[self.question_index]
            self.question_label.text = f"[b][color=#4169E1]Pergunta {self.question_index + 1}:[/color][/b] {question['question']}"
            for i, option in enumerate(question['options']):
                self.option_buttons[i].text = option
                self.option_buttons[i].background_color = (0, 0, 1, 1)
                self.option_buttons[i].color = (1, 1, 1, 1)
            self.progress_bar.value = self.question_index + 1
            self.start_timer()
        else:
            self.manager.current = 'result'

    # iniciar o temporizador
    def start_timer(self):
        if self.timer_event:
            self.timer_event.cancel()
        self.time_left = 30
        self.timer_label.text = f"Tempo: {self.time_left}"
        self.timer_label.color = (0, 1, 0, 1)
        self.timer_event = Clock.schedule_interval(self.update_timer, 1)

    def update_timer(self, dt):  # atualizar o temporizador a cada segundo
        self.time_left -= 1
        if self.time_left <= 19:
            self.timer_label.color = (1, 1, 0, 1)
        if self.time_left <= 9:
            self.timer_label.color = (1, 0, 0, 1)
        self.timer_label.text = f"Tempo: {self.time_left}"
        if self.time_left <= 0:
            self.timer_event.cancel()
            self.next_question(None)

    def check_answer(self, instance):  # Verifica a resposta do usuário e atualiza a pontuação
        correct_answer = self.questions[self.question_index]["answer"]
        if instance.text == correct_answer:
            self.animate_correct_answer(instance)
            self.score += 1
            self.score_label.text = f"Pontuação: {self.score}"
        else:
            instance.background_color = (0.8, 0.1, 0.1, 1)
            self.animate_vibration(instance)
        Clock.schedule_once(self.next_question, 0.5)

    def animate_correct_answer(self, button):  # animar o botão da resposta correta
        anim = Animation(background_color=(1, 1, 0, 1), duration=0.1) + \
               Animation(background_color=(0.1, 0.8, 0.1, 1), duration=0.1) + \
               Animation(background_color=(1, 1, 0, 1), duration=0.1) + \
               Animation(background_color=(0.1, 0.8, 0.1, 1), duration=0.1)
        anim.start(button)

    def animate_vibration(self, button):  # animar o botão da resposta errada
        anim = Animation(x=-10, duration=0.1) + Animation(x=10, duration=0.1) + Animation(x=0, duration=0.1)
        anim.start(button)

    def next_question(self, dt):  # avançar para a próxima pergunta
        self.question_index += 1
        self.update_question()

    def show_hint(self, instance):  # mostra uma dica para a pergunta atual
        if self.hint_used < 2:
            hint = self.questions[self.question_index]["answer"]
            self.hint_label.text = f"Dica: {hint}"
            self.hint_used += 1
            Clock.schedule_once(self.remove_hint, 2)
            if self.hint_used == 2:
                self.hint_button.disabled = True
        else:
            self.hint_label.text = "Você usou todas as dicas!"

    def remove_hint(self, dt):  # remove dicas após um tempo
        self.hint_label.text = ""

    def on_enter(self):
        # Zera a pontuação e outras variáveis relevantes
        self.score = 0
        self.question_index = 0
        self.hint_used = 0
        self.score_label.text = "Pontuação: 0"
        self.update_question()

class ResultScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.layout = BoxLayout(orientation='vertical', padding=20, spacing=20)
        self.result_label = Label(font_size=24, markup=True, halign="center")
        restart_button = Button(
            text="Recomeçar",
            font_size=24,
            size_hint=(1, 0.3),
            background_color=((0, 0, 1, 1))
        )
        restart_button.bind(on_press=self.restart_quiz)
        self.layout.add_widget(self.result_label)
        self.layout.add_widget(restart_button)
        self.add_widget(self.layout)

    # Atualiza o texto do resultado com base na pontuação do usuário quando a tela é exibida
    def on_enter(self):
        quiz_screen = self.manager.get_screen('quiz')
        score = quiz_screen.score
        total_questions = len(quiz_screen.questions)
        percentage = (score / total_questions) * 100  # porcentagem
        if score >= 7:  # se as respostas forem acima de 7, você receberá uma mensagem na tela parabéns, se não for, receberá tente novamente
            self.result_label.text = f"[b][color=#00FF00]Parabéns! Você acertou {score} de {total_questions} perguntas![/color][/b]\n[b][color=#00FF00]Porcentagem de acertos: {percentage:.2f}%[/color][/b]"
        else:
            self.result_label.text = f"[b][color=#FF0000]Você acertou {score} de {total_questions} perguntas. Tente na próxima vez![/color][/b]\n[b][color=#FF0000]Porcentagem de acertos: {percentage:.2f}%[/color][/b]"

    # reinicia o quiz e volta para a tela inicial
    def restart_quiz(self, instance):
        quiz_screen = self.manager.get_screen('quiz')
        quiz_screen.score = 0
        quiz_screen.question_index = 0
        quiz_screen.hint_used = 0
        quiz_screen.update_question()
        self.manager.current = 'start'

# classe principal do aplicativo que gerencia as telas
class QuizApp(App):
    def build(self):
        sm = ScreenManager(transition=FadeTransition())
        sm.add_widget(StartScreen(name='start'))
        sm.add_widget(QuizScreen(name='quiz'))
        sm.add_widget(ResultScreen(name='result'))
        return sm

if __name__ == '__main__':
    QuizApp().run()
