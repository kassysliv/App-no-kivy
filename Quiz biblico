class StartScreen(Screen):  # Tela inicial onde o usuário seleciona a dificuldade e começa o quiz
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=20, spacing=20)

        title = Label(  # titulo
            text="[b]Bem-vindo ao Quiz Bíblico![/color][/b]",
            font_size=32,
            markup=True,
            halign="center",
            color=(1, 1, 1, 1)
        )

        subtitle = Label(  # subtítulo
            text="[i]Teste seus conhecimentos sobre a Bíblia![/i]",
            font_size=18,
            markup=True,
            color=(1, 1, 1, 1)
        )

        self.difficulty_spinner = Spinner(  # spinner para selecionar a dificuldade, o usuário que escolhe
            text='Selecione a dificuldade',
            values=('Fácil', 'Médio', 'Difícil'),
            size_hint=(1, 0.3),
            background_color=(0, 0, 1, 1)
        )

        start_button = Button(  # botão para começar o quiz
            text="Começar",
            font_size=24,
            size_hint=(1, 0.3),
            background_color=(0, 0, 1, 1)
        )
        start_button.bind(on_press=self.start_quiz)

        layout.add_widget(title)  # adicionar os widgets ao layout
        layout.add_widget(subtitle)
        layout.add_widget(self.difficulty_spinner)
        layout.add_widget(start_button)
        self.add_widget(layout)

    def start_quiz(self, instance):  # função chamada quando o botão começar
        selected_difficulty = self.difficulty_spinner.text  # starquiz e um botão chamado de começar
        if selected_difficulty != 'Selecione a dificuldade':
            self.manager.current = 'quiz'
            self.manager.get_screen('quiz').set_difficulty(selected_difficulty)

