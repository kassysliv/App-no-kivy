    def set_difficulty(self, difficulty):
        if difficulty == 'Fácil':
            self.questions = self.easy_questions
        elif difficulty == 'Médio':
            self.questions = self.medium_questions
        elif difficulty == 'Difícil':
            self.questions = self.hard_questions
        self.progress_bar.max = len(self.questions)
        self.update_question()

    def update_question(self): #  Se todas as perguntas forem respondidas, você muda para a tela de resultados, e vai atualizando a pergunta atual como opções de resposta e o cronômetro
        if self.question_index < len(self.questions):
            question = self.questions[self.question_index]
            self.question_label.text = f"[b][color=#4169E1]Pergunta {self.question_index + 1}:[/color][/b] {question['question']}"
            for i, option in enumerate(question['options']):
                self.option_buttons[i].text = option
                self.option_buttons[i].background_color = (0, 0, 1, 1)
                self.option_buttons[i].color = (1, 1, 1, 1)
            self.progress_bar.value = self.question_index + 1
            self.start_timer()
        else:
            self.manager.current = 'result'

    def start_timer(self):# iniciar o cronômetro para pergunta atual
        if self.timer_event:
            self.timer_event.cancel()

        self.time_left = 30
        self.timer_label.text = f"Tempo: {self.time_left}"
        self.timer_label.color = (0, 1, 0, 1)
        self.timer_event = Clock.schedule_interval(self.update_timer, 1)

    def update_timer(self, dt):#que atualiza o cronômetro a cada segundo e muda para a próxima pergunta quando o tempo acabar
        self.time_left -= 1
        if self.time_left <= 19:
            self.timer_label.color = (1, 1, 0, 1)
        if self.time_left <= 9:
            self.timer_label.color = (1, 0, 0, 1)
        self.timer_label.text = f"Tempo: {self.time_left}"

        if self.time_left <= 0:
            self.timer_event.cancel()
            self.next_question(None)

    def check_answer(self, instance):#ara verificar se a resposta selecionada está correta. Se desejar, anime o botão e aumente a pontuação. Caso contrário, muda a cor do botão e anima uma vibração. Em seguida, agenda a próxima pergunta
        correct_answer = self.questions[self.question_index]["answer"]
        if instance.text == correct_answer:
            self.animate_correct_answer(instance)
            self.score += 1
            self.score_label.text = f"Pontuação: {self.score}"
        else:
            instance.background_color = (0.8, 0.1, 0.1, 1)
            self.animate_vibration(instance)

        Clock.schedule_once(self.next_question, 0.5)

    def animate_correct_answer(self, button):
        anim = Animation(background_color=(1, 1, 0, 1), duration=0.1) + \
               Animation(background_color=(0.1, 0.8, 0.1, 1), duration=0.1) + \
               Animation(background_color=(1, 1, 0, 1), duration=0.1) + \
               Animation(background_color=(0.1, 0.8, 0.1, 1), duration=0.1) # anima o botão da resposta correta ele brilha
        anim.start(button)

    def animate_vibration(self, button): #que anima uma animação no botão se a resposta estiver incorreta o botão ele vibra
        anim = Animation(x=-10, duration=0.1) + Animation(x=10, duration=0.1) + Animation(x=0, duration=0.1)
        anim.start(button)

    def next_question(self, dt): #incrementa o índice da pergunta e atualiza a pergunta atual
        self.question_index += 1
        self.update_question()

    def show_hint(self, instance):# Verifica se a dica foi usada menos de duas vezes

        if self.hint_used < 2:
            hint = self.questions[self.question_index]["answer"]
            self.hint_label.text = f"Dica: {hint}"  # Atualiza o Label com a dica
            self.hint_used += 1  # Incrementa o contador de dicas usadas

            Clock.schedule_once(self.remove_hint, 2) # Exibe a dica por 2 segundos e depois a remove


            if self.hint_used == 2: # Desabilita o botão de dica após usado duas vezes
                self.hint_button.disabled = True
        else:
            self.hint_label.text = "Você usou todas as dicas!"

    def remove_hint(self, dt):
        self.hint_label.text = ""  # Remove o texto da dica apos 2 segundos


class ResultScreen(Screen): #inicializa a tela com layout, rótulo para o resultado e botão para reiniciar o quiz
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.layout = BoxLayout(orientation='vertical', padding=20, spacing=20)
        self.result_label = Label(font_size=24, markup=True, halign="center")
        restart_button = Button(
            text="Recomeçar",
            font_size=24,
            size_hint=(1, 0.3),
            background_color=((0,0,1, 1))
        )
        restart_button.bind(on_press=self.restart_quiz)
        



        self.layout.add_widget(self.result_label)
        self.layout.add_widget(restart_button)
        self.add_widget(self.layout)

    def on_enter(self):
        quiz_screen = self.manager.get_screen('quiz')# cacula a pontuação e mostra a mensagem baseada no desempenho do usuário
        score = quiz_screen.score
        total_questions = len(quiz_screen.questions)



        if score > 7: # se a nota for masior do que 7 você receberá uma frase parabéns você acertou e a quantidade da pontuação, se for abaixo de 7 você receberá tente na proxima vez e a cor da frase e vermelha
            self.result_label.text = f"[b][color=#00FF00]Parabéns! Você acertou {score} de {total_questions} perguntas![/color][/b]"
        else:
            self.result_label.text = f"[b][color=#FF0000] Você acertou {score} de {total_questions} perguntas. Tente na próxima vez![/color][/b]"

    def restart_quiz(self, instance):
        quiz_screen = self.manager.get_screen('quiz')
        quiz_screen.score = 0
        quiz_screen.question_index = 0
        quiz_screen.hint_used = 0  # reinicia o quiz ao redefinir a pontuação, índice de perguntas e contador de dicas
        quiz_screen.update_question()
        self.manager.current = 'start'




class QuizApp(App): # essa função ela constrói o aplicativo e com transição de fade e adição na tela
    def build(self):
        sm = ScreenManager(transition=FadeTransition())
        sm.add_widget(StartScreen(name='start'))
        sm.add_widget(QuizScreen(name='quiz'))
        sm.add_widget(ResultScreen(name='result'))
        return sm


if __name__ == '__main__':
    QuizApp().run()
